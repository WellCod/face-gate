# Limiar mínimo de similaridade (cosseno) para liberar acesso (0.0 a 1.0).
SIMILARITY_THRESHOLD=0.70

# Modelo de reconhecimento facial usado pelo DeepFace.
# Opções: VGG-Face, Facenet, Facenet512, OpenFace, DeepFace, DeepID, ArcFace, Dlib, SFace
DEEPFACE_MODEL=ArcFace

# Detector facial usado pelo DeepFace.
# Opções: opencv, ssd, mtcnn, retinaface, mediapipe, yolov8, yunet, fastmtcnn
DEEPFACE_DETECTOR=retinaface

# Pasta para imagens de auditoria de cada tentativa de verificação.
AUDIT_FOLDER=auditoria

# Pasta para imagens de rostos cadastrados.
FACES_FOLDER=rostos_cadastrados
